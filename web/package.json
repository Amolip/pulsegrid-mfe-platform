{
  "name": "pulsegrid-mfe-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "node --require ./node-compat.cjs ./node_modules/@angular/cli/bin/ng.js",
    "start": "node --require ./node-compat.cjs ./node_modules/@angular/cli/bin/ng.js serve --port 4202",
    "build": "node --require ./node-compat.cjs ./node_modules/@angular/cli/bin/ng.js build",
    "watch": "node --require ./node-compat.cjs ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "node --require ./node-compat.cjs ./node_modules/@angular/cli/bin/ng.js test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "graphql": "^16.10.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "typescript": "~6.0.0"
  }
}
